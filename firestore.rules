rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == "hemanaruto3044@gmail.com"
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---

    function isValidLog(data) {
      return data.keys().hasAll(['username', 'code', 'createdAt']) &&
             data.keys().size() == 3 &&
             data.username is string && data.username.size() > 0 && data.username.size() <= 100 &&
             data.code is string && data.code.size() > 0 && data.code.size() <= 100000 &&
             data.createdAt == request.time;
    }

    // --- Rules ---

    match /logs/{logId} {
      // Anyone can create a log (assuming we don't want to force sign-in for users to submit scripts)
      // Or should we force sign-in? The prompt doesn't specify user login. 
      // But for security, anonymous login or just open write with validation is okay for a "script engine" demo.
      // I'll allow create if the data is valid.
      allow create: if isValidLog(incoming());
      
      // Only admins can read, list, or delete logs.
      allow read, list, delete: if isAdmin();
      
      // Logs are immutable.
      allow update: if false;
    }

    match /admins/{adminId} {
      // Only existing admins can add other admins.
      // Or just prohibit client-side admin creation for this demo.
      allow read: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow write: if false; // Managed via console or backend
    }
  }
}
